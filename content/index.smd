---
.title = "gif.sccl.cc - anon minimal client-side gif maker",
.date = .date("2026-10-07T00:00:00"),
.authors = ["sccl"],
.layout = "page.shtml",
.custom = .{
    .tab = "home",
    .description = "Create GIFs from videos and images. Free, no tracking. Direct permalinks for Discord & Telegram.",
},
---

```=html
<div id="app">
  <div id="drop-zone">
    <p><span class="symbol">+</span> drop video or images here</p>
    <p class="hint">or click to browse &nbsp;|&nbsp; or paste from clipboard &nbsp;|&nbsp; mp4, webm, mov, avi, png, jpg, gif, webp (animated gif/webp supported)</p>
    <input type="file" id="file-input" accept="video/*,image/*" multiple style="display:none">
  </div>

  <div id="source-preview" style="display:none">
    <div id="video-preview" style="display:none">
      <video id="video-player" controls style="max-width:100%;max-height:300px"></video>
      <div id="trim-controls">
        <label>start: <input type="number" id="trim-start" min="0" step="0.1" value="0">s</label>
        <label>end: <input type="number" id="trim-end" min="0" step="0.1" value="0">s</label>
        <div class="dual-range">
          <input type="range" id="trim-range-start" class="range-start" min="0" step="0.1" value="0">
          <input type="range" id="trim-range-end" class="range-end" min="0" step="0.1" value="0">
          <div class="range-track"><div class="range-fill" id="range-fill"></div></div>
        </div>
      </div>
    </div>
    <div id="image-preview" style="display:none">
      <div id="image-list"></div>
    </div>
    <div id="crop-controls" style="display:none;margin-top:.75rem">
      <p class="section-title">crop</p>
      <div id="crop-stage">
        <img id="crop-img" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="crop preview">
        <div id="crop-box">
          <div class="crop-handle" data-edge="n"></div>
          <div class="crop-handle" data-edge="s"></div>
          <div class="crop-handle" data-edge="w"></div>
          <div class="crop-handle" data-edge="e"></div>
        </div>
      </div>
      <div class="settings-grid" style="margin-top:.5rem">
        <label>top <input type="number" id="crop-top" min="0" value="0">px</label>
        <label>bottom <input type="number" id="crop-bottom" min="0" value="0">px</label>
        <label>left <input type="number" id="crop-left" min="0" value="0">px</label>
        <label>right <input type="number" id="crop-right" min="0" value="0">px</label>
      </div>
    </div>
  </div>

  <div id="settings" style="display:none">
    <p class="section-title">settings</p>
    <div class="settings-grid">
      <label>format
        <select id="opt-format">
          <option value="webp" selected>webp</option>
          <option value="gif">gif</option>
        </select>
      </label>
      <label>width <input type="number" id="opt-width" min="32" max="1920" value="480" step="16"><span class="hint">(32-1920)</span></label>
      <label>fps <input type="number" id="opt-fps" min="1" max="30" value="10"><span id="fps-hint" class="hint">(1-30)</span></label>
      <label class="gif-only">colors
        <select id="opt-colors">
          <option value="256">256</option>
          <option value="128">128</option>
          <option value="64">64</option>
          <option value="32">32</option>
        </select>
      </label>
      <label class="gif-only">dithering
        <select id="opt-dither">
          <option value="">none</option>
          <option value="Bayer">bayer</option>
          <option value="FloydSteinberg">floyd-steinberg</option>
        </select>
      </label>
      <label>quality <input type="number" id="opt-quality" min="1" max="20" value="10"><span id="quality-hint" class="hint">(higher=better)</span></label>
      <label class="gif-only">repeat <select id="opt-repeat"><option value="0">forever</option><option value="1">once</option></select></label>
    </div>
  </div>

  <div id="actions" style="display:none">
    <button id="btn-create" class="btn">[ create gif ]</button>
  </div>

  <div id="progress" style="display:none">
    <p>encoding <span id="progress-fmt" style="color:var(--nord8)"></span> <span id="progress-pct">0%</span></p>
    <div id="progress-bar"><div id="progress-fill"></div></div>
  </div>

  <div id="result" style="display:none">
    <p class="section-title">preview</p>
    <img id="gif-preview" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="generated gif preview">
    <p class="hint" id="gif-size"></p>
    <div id="save-area">
      <label><input type="checkbox" id="chk-public" checked> make public</label>
      <label>tags: <span id="tags-wrapper" style="display:inline-flex;flex-wrap:wrap;gap:.2rem;align-items:center;background:var(--nord0);border:1px solid var(--nord3);padding:.2rem .4rem;min-width:200px;cursor:text"><span id="tags-chips"></span><input type="text" id="opt-tags-input" placeholder="add tag..." style="border:none;background:transparent;color:var(--fg);font-family:Space Mono,monospace;font-size:.875rem;outline:none;width:150px;padding:0"><input type="hidden" id="opt-tags" value=""></span></label>
      <label>file-name (optional): <input type="text" id="opt-slug" maxlength="40" placeholder="catkitty123 (a-z 0-9)" style="color:var(--fg);background:var(--nord0);border:1px solid var(--nord3);font-family:Space Mono,monospace;font-size:.875rem;padding:.2rem .4rem;width:220px"><span class="hint">(latin only, no symbols; e.g. mraw111meow000)</span></label>
    </div>
    <div class="result-actions">
      <button id="btn-save" class="btn">[ get permanent link ]</button>
      <button id="btn-download" class="btn">[ download ]</button>
    </div>
    <div id="turnstile-widget" style="margin-top:.5rem"></div>
    <div>
    <span id="auth-prompt" class="hint"><a href="/login">login</a> for uploading without cf captcha and higher limits</span>
    </div>
    <div id="save-result" style="display:none">
      <p>permanent url: <a id="gif-url"></a></p>
      <button id="btn-copy-perm" class="btn">[ copy url ]</button>
      <p class="hint" id="delete-hint"></p>
    </div>
  </div>

  <div id="error" style="display:none">
    <p class="error-msg"></p>
  </div>
</div>

<script src="/js/gif.js?v=COMMIT_HASH"></script>
<script src="/js/app.js?v=COMMIT_HASH"></script>
```
