```=html
<div id="gallery-app">
  <div id="user-gallery-section" style="display:none">
    <p class="section-id">> my gifs</p>
    <div id="user-gallery-grid"></div>
  </div>
  <p class="section-id">> public gifs</p>
  <div id="gallery-grid"></div>
  <div id="gallery-empty" style="display:none">
    <p>no gifs yet. <a href="/">create one</a></p>
  </div>
  <div id="gallery-loading"><p>loading...</p></div>
  <div id="gallery-error" style="display:none"><p class="error-msg"></p></div>
</div>

<script src="/js/gallery.js"></script>
